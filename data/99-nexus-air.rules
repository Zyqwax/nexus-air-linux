# Nexus Air V1 Wireless/Wired Gaming Mouse (Compx / Claw's Technology)
# Grants unprivileged user read/write access to HID raw interfaces for configuring DPI, RGB, polling rate, etc.
KERNEL=="hidraw*", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="f512", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="f5d5", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="f5a7", MODE="0666", TAG+="uaccess"
